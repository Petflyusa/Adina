# GEMINI_API_KEY: Required for Gemini AI API calls (optional - currently unused in production)
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted (used for self-referential links)
APP_URL="https://your-domain.com"

# Server Port
PORT=8000

# ==========================================
# MySQL Database Configuration (Hostinger)
# ==========================================
DB_HOST="your-database-host"
DB_PORT="3306"
DB_USER="your-database-user"
DB_PASSWORD="use-a-secret-managed-by-your-host"
DB_NAME="your-database-name"
SESSION_SECRET="generate-at-least-32-random-bytes"

# Optional: Supabase Storage (for file uploads - leave as-is unless you migrated storage too)
SUPABASE_ANON_KEY=""
